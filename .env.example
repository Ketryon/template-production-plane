# --- The observed system (required) ------------------------------------------
#
# A READ-ONLY Postgres role on the production database you are observing. Not an
# owner, and never a service-role key — those bypass row-level security and can
# write. The grants belong in migrations/observed/, so what this role can see is
# reviewable in a diff.
#
# Treat this as the highest-value secret in the repo. Read README.md#blast-radius
# and write down what it actually reaches before you deploy anything.
OBSERVED_DATABASE_URL=postgresql://<role>:<password>@<host>:5432/<db>?sslmode=require

# --- Auth (required) ---------------------------------------------------------
#
# The observed system's own auth project. Sign-in is a magic link, gated on that
# system's existing admin flag, so there is no second user list and revoking
# someone there revokes them here. The anon key is public by design.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- The vendor being observed (optional) ------------------------------------
#
# Only if this plane also reads a third-party API. Leave unset and the vendor
# half simply does not appear.
VENDOR_API_BASE_URL=https://api.example.com

# --- This plane's own store (optional) ---------------------------------------
#
# The call log, and nothing else. Connect as a LEAST-PRIVILEGE role — SELECT,
# INSERT and DELETE on one table, no CREATE — so the running app cannot reshape
# what it writes to. Schema comes from migrations/own/.
#
# No secrets in the log, but response bodies ARE production personal data.
# Retained 30 days, then swept. See lib/store.ts.
PLANE_DATABASE_URL=postgresql://<app-role>:<password>@<host>/<db>?sslmode=require
